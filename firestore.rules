rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (!exists(/databases/$(database)/documents/administradores/$(request.auth.uid)) ||
          get(/databases/$(database)/documents/administradores/$(request.auth.uid)).data.get('ativo', true) != false) && (
        ('admin' in request.auth.token && request.auth.token.admin == true) ||
        exists(/databases/$(database)/documents/administradores/$(request.auth.uid))
      );
    }

    match /usuarios/{userId} {
      // Proteção de dados pessoais (LGPD): apenas o próprio usuário ou administradores podem ler e gravar
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && (
        isAdmin() || (
          request.auth.uid == userId &&
          request.resource.data.keys().hasOnly([
            'uid', 'nome', 'email', 'telefone', 'dataNascimento', 'fotoUrl',
            'criadoEm', 'atualizadoEm'
          ]) &&
          (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid) &&
          request.resource.data.email == request.auth.token.email
        )
      );
      allow update: if isAuthenticated() && (
        isAdmin() || (
          request.auth.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'nome', 'telefone', 'dataNascimento', 'fotoUrl', 'atualizadoEm', 'anoUltimoResgateAniversario'
          ]) &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['anoUltimoResgateAniversario']) ||
            request.resource.data.anoUltimoResgateAniversario == request.time.year())
        )
      );
      allow delete: if isAdmin();
    }

    match /clientes/{clienteId} {
      // CRM de Clientes e dados de perfil (LGPD): exclusivo para administradores
      allow read, write: if isAdmin();
    }

    match /agendamentos/{agendamentoId} {
      // Dados pessoais: somente o cliente proprietário ou administradores.
      // A grade pública utiliza exclusivamente slots_agendamentos.
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      // Criação, alteração e cancelamento são exclusivos do servidor (Admin SDK) ou administrador.
      // Clientes utilizam as rotas autoritativas da API para confirmar e cancelar agendamentos.
      allow create, update, delete: if isAdmin();
    }

    match /slots_agendamentos/{slotId} {
      allow read: if true;
      allow create, update: if isAdmin() && request.resource.data.keys().hasOnly([
        'slotId', 'dataHora', 'barbeiroId', 'barbeiroNome', 'status', 'expiraEm', 'atualizadoEm'
      ]);
      allow delete: if isAdmin();
    }
    match /slots_proprietarios/{slotId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    match /servicos/{servicoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /planosMensais/{planoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /planos/{planoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /barbeiros/{barbeiroId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /assinaturasClientes/{userId} {
      // Cada cliente acessa apenas a própria assinatura; administradores gerenciam a base.
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      // Ativação, migração e consumo de semanas são sempre decididos pelo backend/Admin SDK.
      allow write: if isAdmin();
    }

    match /produtos/{produtoId} {
      allow read: if true;
      // Estoque e catálogo são alterados apenas pelo backend/Admin SDK ou admin.
      allow create, update, delete: if isAdmin();
    }

    match /comprasProdutos/{compraId} {
      // Leitura apenas pelo próprio comprador ou admins
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      // Registros de venda são criados pelo backend após confirmação.
      allow create, update, delete: if isAdmin();
    }

    match /diasBloqueados/{diaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Documentos privados de configuração (apenas Admin pode ler ou escrever)
    match /configuracoes/pagamento_privado {
      allow read, write: if isAdmin();
    }

    match /configuracoes/{configId} {
      allow read: if configId != 'pagamento_privado';
      allow write: if isAdmin();
    }

    match /administradores/{adminId} {
      allow read: if isAuthenticated() && (request.auth.uid == adminId || isAdmin());
      allow write: if isAdmin();
    }

    match /fidelidadeClientes/{userId} {
      // Clientes podem apenas consumir uma recompensa existente; nunca criar ou acrescentar selos.
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create, delete: if isAdmin();
      allow update: if isAuthenticated() && (
        isAdmin() || (
          request.auth.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'selosAtuais', 'recompensasUtilizadas', 'recompensaDisponivel', 'atualizadoEm'
          ]) &&
          request.resource.data.selosAtuais is number &&
          request.resource.data.selosAtuais >= 0 &&
          resource.data.selosAtuais >= get(/databases/$(database)/documents/configuracoes/fidelidade).data.metaSelos &&
          request.resource.data.selosAtuais == resource.data.selosAtuais - get(/databases/$(database)/documents/configuracoes/fidelidade).data.metaSelos &&
          request.resource.data.recompensaDisponivel == (request.resource.data.selosAtuais >= get(/databases/$(database)/documents/configuracoes/fidelidade).data.metaSelos) &&
          request.resource.data.recompensasUtilizadas == resource.data.get('recompensasUtilizadas', 0) + 1
        )
      );
    }

    match /galeria_cortes_clientes/{fotoId} {
      // Foto pessoal: somente o cliente vinculado e administradores podem ler.
      allow read: if isAuthenticated() && (
        resource.data.clienteId == request.auth.uid ||
        isAdmin()
      );
      // Inclusão/remoção é exclusiva do painel administrativo.
      allow create, update, delete: if isAdmin();
    }

    match /promocoes/{promocaoId} {
      // Leitura pública para aplicação de descontos nos agendamentos e produtos
      allow read: if true;
      // Criação, alteração e exclusão restritas a administradores (evita promoções falsas)
      allow write: if isAdmin();
    }

    // Coleções de Controle Financeiro / Gastos / Despesas (Acesso exclusivo para Administradores)
    match /gastos/{gastoId} {
      allow read, write: if isAdmin();
    }

    match /despesas/{despesaId} {
      allow read, write: if isAdmin();
    }

    match /solicitacoes_pix_manual/{id} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    match /pagamentos_pendentes/{paymentId} {
      // Estado de processamento e dados do pedido são autoridade do servidor.
      allow create, update, delete: if isAdmin();
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
    }

    match /resgates_beneficios/{id} {
      // Recibos e histórico de benefícios consumidos vinculados ao usuário
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    match /estornos_extras/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /assinaturas_historico/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /_whatsapp_session/{docId} {
      // Sessões do WhatsApp Baileys gerenciadas internamente pelo servidor via Admin SDK
      allow read, write: if false;
    }
  }
}
