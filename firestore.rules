rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'aldo540@outlook.com' ||
        request.auth.token.email == 'rafaelcassu@hotmail.com' ||
        request.auth.token.admin == true
      );
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    match /usuarios/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    match /agendamentos/{agendamentoId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        isAdmin() ||
        resource.data.cliente == request.auth.token.email
      );
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow update, delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        isAdmin()
      );
    }

    match /servicos/{servicoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /planos/{planoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /assinaturasClientes/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create, update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    match /diasBloqueados/{diaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /configuracoes/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /administradores/{adminId} {
      allow read: if isAuthenticated() && (isAdmin() || request.auth.token.email == 'rafaelcassu@hotmail.com');
      allow write: if isAdmin();
    }
  }
}