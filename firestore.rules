rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        ('admin' in request.auth.token && request.auth.token.admin == true) ||
        exists(/databases/$(database)/documents/administradores/$(request.auth.uid))
      );
    }

    match /usuarios/{userId} {
      // Proteção de dados pessoais (LGPD): apenas o próprio usuário ou administradores podem ler e gravar
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    match /clientes/{clienteId} {
      // CRM de Clientes e dados de perfil (LGPD): exclusivo para administradores
      allow read, write: if isAdmin();
    }

    match /agendamentos/{agendamentoId} {
      // Dados pessoais: somente o cliente proprietário ou administradores.
      // A grade pública utiliza exclusivamente slots_agendamentos.
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      // Criação: exige que o userId pertença ao próprio usuário autenticado OU seja criado por administrador (balcão)
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      // Apenas o próprio cliente dono do agendamento ou administrador pode alterar/cancelar
      allow update, delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.clienteEmail == request.auth.token.email ||
        isAdmin()
      );
    }

    match /slots_agendamentos/{slotId} {
      // Grade pública sem dados pessoais. A titularidade fica em slots_proprietarios.
      allow read: if true;
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasOnly([
          'slotId', 'dataHora', 'barbeiroId', 'barbeiroNome',
          'status', 'expiraEm', 'atualizadoEm'
        ]) && (
          isAdmin() || (
            existsAfter(/databases/$(database)/documents/slots_proprietarios/$(slotId)) &&
            getAfter(/databases/$(database)/documents/slots_proprietarios/$(slotId)).data.userId == request.auth.uid
          )
        );
      allow update: if isAuthenticated() &&
        request.resource.data.keys().hasOnly([
          'slotId', 'dataHora', 'barbeiroId', 'barbeiroNome',
          'status', 'expiraEm', 'atualizadoEm'
        ]) && (
          isAdmin() || (
            exists(/databases/$(database)/documents/slots_proprietarios/$(slotId)) &&
            get(/databases/$(database)/documents/slots_proprietarios/$(slotId)).data.userId == request.auth.uid
          ) || (
            resource.data.status in ['pendente', 'pendente_pagamento'] &&
            resource.data.expiraEm is number &&
            resource.data.expiraEm <= request.time.toMillis() &&
            existsAfter(/databases/$(database)/documents/slots_proprietarios/$(slotId)) &&
            getAfter(/databases/$(database)/documents/slots_proprietarios/$(slotId)).data.userId == request.auth.uid
          )
        );
      allow delete: if isAuthenticated() && (
        isAdmin() || (
          exists(/databases/$(database)/documents/slots_proprietarios/$(slotId)) &&
          get(/databases/$(database)/documents/slots_proprietarios/$(slotId)).data.userId == request.auth.uid
        )
      );
    }

    match /slots_proprietarios/{slotId} {
      allow create: if isAuthenticated() && (
        isAdmin() || (
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.keys().hasOnly(['userId', 'paymentId', 'atualizadoEm'])
        )
      );
      allow read, delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow update: if isAuthenticated() && (
        isAdmin() || (
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.keys().hasOnly(['userId', 'paymentId', 'atualizadoEm'])
        ) || (
          get(/databases/$(database)/documents/slots_agendamentos/$(slotId)).data.status in ['pendente', 'pendente_pagamento'] &&
          get(/databases/$(database)/documents/slots_agendamentos/$(slotId)).data.expiraEm is number &&
          get(/databases/$(database)/documents/slots_agendamentos/$(slotId)).data.expiraEm <= request.time.toMillis() &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.keys().hasOnly(['userId', 'paymentId', 'atualizadoEm'])
        )
      );
    }

    match /servicos/{servicoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /planosMensais/{planoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /planos/{planoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /barbeiros/{barbeiroId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /assinaturasClientes/{userId} {
      // Leitura restrita ao próprio usuário ou administradores
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    match /produtos/{produtoId} {
      allow read: if true;
      // Estoque e catálogo são alterados apenas pelo backend/Admin SDK ou admin.
      allow create, update, delete: if isAdmin();
    }

    match /comprasProdutos/{compraId} {
      // Leitura apenas pelo próprio comprador ou admins
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      // Registros de venda são criados pelo backend após confirmação.
      allow create, update, delete: if isAdmin();
    }

    match /diasBloqueados/{diaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Documentos privados de configuração (apenas Admin pode ler ou escrever)
    match /configuracoes/pagamento_privado {
      allow read, write: if isAdmin();
    }

    match /configuracoes/{configId} {
      allow read: if configId != 'pagamento_privado';
      allow write: if isAdmin();
    }

    match /administradores/{adminId} {
      allow read: if isAuthenticated() && (request.auth.uid == adminId || isAdmin());
      allow write: if isAdmin();
    }

    match /fidelidadeClientes/{userId} {
      // Leitura e gravação restritas ao próprio usuário ou admins
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    match /galeria_cortes_clientes/{fotoId} {
      // Foto pessoal: somente o cliente vinculado e administradores podem ler.
      allow read: if isAuthenticated() && (
        resource.data.clienteId == request.auth.uid ||
        isAdmin()
      );
      // Inclusão/remoção é exclusiva do painel administrativo.
      allow create, update, delete: if isAdmin();
    }

    match /promocoes/{promocaoId} {
      // Leitura pública para aplicação de descontos nos agendamentos e produtos
      allow read: if true;
      // Criação, alteração e exclusão restritas a administradores (evita promoções falsas)
      allow write: if isAdmin();
    }

    // Coleções de Controle Financeiro / Gastos / Despesas (Acesso exclusivo para Administradores)
    match /gastos/{gastoId} {
      allow read, write: if isAdmin();
    }

    match /despesas/{despesaId} {
      allow read, write: if isAdmin();
    }

    match /pagamentos_pendentes/{paymentId} {
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow read, delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        (
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'motivo', 'atualizadoEm'])
        ) ||
        isAdmin()
      );
    }
  }
}
