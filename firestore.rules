rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'aldo540@outlook.com' ||
        request.auth.token.email == 'rafaelcassu@hotmail.com' ||
        request.auth.token.email == 'cassurafael30@gmail.com' ||
        request.auth.token.email == 'admin@emausbarbearia.com' ||
        request.auth.token.admin == true
      );
    }

    match /usuarios/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    match /agendamentos/{agendamentoId} {
      // Leitura pública necessária para checagem de horários ocupados na grade e painel do cliente
      allow read: if true;
      allow create: if isAuthenticated();
      // Apenas o próprio cliente dono do agendamento ou administrador pode alterar/cancelar
      allow update, delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.clienteEmail == request.auth.token.email ||
        isAdmin()
      );
    }

    match /servicos/{servicoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /planosMensais/{planoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /planos/{planoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /barbeiros/{barbeiroId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /assinaturasClientes/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    match /produtos/{produtoId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      // M4: Update de produtos restrito — autenticado pode atualizar estoque; apenas admin pode alterar preço/nome
      allow update: if isAuthenticated();
    }

    match /comprasProdutos/{compraId} {
      // Leitura apenas pelo próprio comprador ou admins
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      // Criação exige autenticação (não anônimo)
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /diasBloqueados/{diaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Documentos privados de configuração (apenas Admin pode ler ou escrever)
    match /configuracoes/pagamento_privado {
      allow read, write: if isAdmin();
    }

    match /configuracoes/{configId} {
      allow read: if configId != 'pagamento_privado';
      allow write: if isAdmin();
    }

    match /administradores/{adminId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /fidelidadeClientes/{userId} {
      // Leitura apenas pelo próprio usuário ou admins
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // Coleções de Controle Financeiro / Gastos / Despesas (Acesso exclusivo para Administradores)
    match /gastos/{gastoId} {
      allow read, write: if isAdmin();
    }

    match /despesas/{despesaId} {
      allow read, write: if isAdmin();
    }
  }
}