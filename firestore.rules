rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'aldo540@outlook.com' ||
        request.auth.token.email == 'rafaelcassu@hotmail.com' ||
        request.auth.token.admin == true
      );
    }

    match /usuarios/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    match /agendamentos/{agendamentoId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAuthenticated();
    }

    match /servicos/{servicoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /planosMensais/{planoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /planos/{planoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /barbeiros/{barbeiroId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /assinaturasClientes/{userId} {
      allow read: if true;
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    match /produtos/{produtoId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if true;
    }

    match /comprasProdutos/{compraId} {
      allow read: if isAuthenticated();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /diasBloqueados/{diaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /configuracoes/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /administradores/{adminId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /fidelidadeClientes/{userId} {
      allow read: if true;
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }
  }
}