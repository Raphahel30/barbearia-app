{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "firestore.rules",
      "firebase-service-account.json",
      "firebase-adminsdk*.json",
      ".env*",
      "*.pem",
      "*.key",
      "package.json",
      "package-lock.json",
      "render.yaml",
      "**/.*",
      "**/node_modules/**",
      "server/**",
      "api/**",
      "docs/**",
      "skills/**"
    ],
    "cleanUrls": true,
    "rewrites": [
      {
        "source": "/__/auth/action",
        "destination": "/redefinir-senha.html"
      },
      {
        "source": "/admin",
        "destination": "/admin.html"
      },
      {
        "source": "/redefinir-senha",
        "destination": "/redefinir-senha.html"
      },
      {
        "source": "/termos",
        "destination": "/termos.html"
      }
    ]
  }
}